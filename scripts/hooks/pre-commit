#!/usr/bin/env bash
# pre-commit hook — AI Governance Framework
#
# 檢查 PLAN.md 新鮮度：
#   CRITICAL (距今 > 2× threshold) → 擋 commit，要求更新
#   STALE    (距今 > threshold)    → 警告，允許 commit
#   FRESH                          → 通過
#
# 安裝方式：
#   bash scripts/install-hooks.sh
#   或手動複製到 .git/hooks/pre-commit 並 chmod +x

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || git -C "$HOOK_DIR" rev-parse --show-toplevel 2>/dev/null || pwd)"
FRAMEWORK_ROOT="${AI_GOVERNANCE_FRAMEWORK_ROOT:-}"
HOOK_CONFIG="$HOOK_DIR/ai-governance-framework-root"
if [ -z "$FRAMEWORK_ROOT" ] && [ -f "$HOOK_CONFIG" ]; then
    FRAMEWORK_ROOT="$(cat "$HOOK_CONFIG")"
fi
if [ -z "$FRAMEWORK_ROOT" ]; then
    FRAMEWORK_ROOT="$TARGET_REPO_ROOT"
fi


# Keep this bootstrap self-contained: the shared checkout may have been removed.
# Only the configured submodule in a registered worktree can supply a local pin;
# an explicit override or an external installation keeps its existing authority.
resolve_worktree_framework() (
    local hook="$1" shared="$FRAMEWORK_ROOT" target="$TARGET_REPO_ROOT"
    local git_dir common record key relative anchor entry bound="" candidate name
    local bound_head="" matching="" declared
    local mode pin stage ignored sub_dir expected head top required directory
    if [ -n "${AI_GOVERNANCE_FRAMEWORK_ROOT:-}" ] || [ ! -f "$target/.git" ]; then
        printf '%s\n' "$shared"; return
    fi
    # Consumer queries retain Git's prepared commit index (commit -a / paths).
    # Only queries in the framework checkout discard consumer repository state.
    framework_git() (
        local root="$1" variable
        shift
        for variable in $(git rev-parse --local-env-vars); do unset "$variable"; done
        GIT_OPTIONAL_LOCKS=0 GIT_NO_REPLACE_OBJECTS=1 git -C "$root" "$@"
    )
    export GIT_OPTIONAL_LOCKS=0
    export GIT_NO_REPLACE_OBJECTS=1
    git_dir="$(git -C "$target" rev-parse --absolute-git-dir)" || return 1
    common="$(git -C "$target" rev-parse --git-common-dir)" || return 1
    git_dir="$(cd -- "$git_dir" && pwd -P)" || return 1
    common="$(cd -- "$target" && cd -- "$common" && pwd -P)" || return 1
    if [ "$git_dir" = "$common" ] || [ ! -f "$target/.gitmodules" ]; then
        printf '%s\n' "$shared"; return
    fi
    shared="${shared%$'\r'}"; shared="${shared//\\//}"
    # cygpath also normalizes drive paths that no longer exist.
    if command -v cygpath >/dev/null 2>&1; then shared="$(cygpath -am "$shared")"; fi
    while IFS= read -r -d '' record; do
        key="${record%%$'\n'*}"; relative="${record#*$'\n'}"
        case "$relative" in ""|/*|*:*|*\\*|../*|*/../*|*/..|.|..|./*|*/./*|*/.) continue ;; esac
        while IFS= read -r -d '' entry; do
            case "$entry" in
                "worktree "*)
                    matching=""
                    anchor="${entry#worktree }/$relative"
                    if command -v cygpath >/dev/null 2>&1; then anchor="$(cygpath -am "$anchor")"; fi
                    if [ "${shared%/}" = "${anchor%/}" ]; then
                        if [ -n "$bound" ]; then
                            echo "[governance] error: ambiguous linked-worktree framework declaration" >&2; return 1
                        fi
                        bound="$key"
                        matching=yes
                    fi ;;
                "HEAD "*) [ "$matching" != yes ] || bound_head="${entry#HEAD }" ;;
            esac
        done < <(git -C "$target" worktree list --porcelain -z)
        [ "$bound" = "$key" ] || continue
        # A nested external installation is not submodule authority. The
        # installing worktree's committed declaration must identify this slot.
        IFS=$' \t' read -r mode ignored < <(git --literal-pathspecs -C "$target" ls-tree "$bound_head" -- "$relative" 2>/dev/null)
        declared="$(git -C "$target" config --blob "$bound_head:.gitmodules" --get "$key" 2>/dev/null)" || declared=""
        if [ "${mode:-}" != 160000 ] || [ "$declared" != "$relative" ]; then
            if [ -d "$FRAMEWORK_ROOT" ]; then printf '%s\n' "$FRAMEWORK_ROOT"; return; fi
            echo "[governance] error: missing shared framework root has no committed submodule authority: $FRAMEWORK_ROOT" >&2; return 1
        fi
        candidate="$target/$relative"
        # HEAD, index and working declaration must agree before dispatching code.
        IFS=$' \t' read -r mode ignored < <(git -C "$target" ls-tree HEAD -- .gitmodules)
        case "${mode:-}" in
            100644|100755) ;;
            *) echo "[governance] error: linked-worktree framework declaration is not a committed regular file" >&2; return 1 ;;
        esac
        if [ -L "$target/.gitmodules" ] ||
           ! git -C "$target" diff --quiet HEAD -- .gitmodules ||
           ! git -C "$target" diff --cached --quiet HEAD -- .gitmodules; then
            echo "[governance] error: linked-worktree framework declaration is not committed and unchanged" >&2; return 1
        fi
        target="$(cd -- "$target" && pwd -P)" || return 1
        candidate="$target/$relative"
        name="${key#submodule.}"; name="${name%.path}"
        IFS=$' \t' read -r mode pin stage ignored < <(git --literal-pathspecs -C "$target" ls-files --stage -- "$relative")
        if [ "${mode:-}" != 160000 ] || [ "${stage:-}" != 0 ] ||
           [ ! -f "$candidate/.git" ] || [ -L "$candidate/.git" ] ||
           [ "$(cd -- "$candidate" 2>/dev/null && pwd -P)" != "$candidate" ]; then
            echo "[governance] error: linked-worktree framework is not an initialized declared submodule: $candidate" >&2; return 1
        fi
        if ! sub_dir="$(framework_git "$candidate" rev-parse --absolute-git-dir 2>/dev/null)" ||
           ! sub_dir="$(cd -- "$sub_dir" && pwd -P)" ||
           ! expected="$(cd -- "$git_dir/modules/$name" 2>/dev/null && pwd -P)" ||
           ! head="$(framework_git "$candidate" rev-parse --verify HEAD 2>/dev/null)" ||
           ! top="$(framework_git "$candidate" rev-parse --show-toplevel 2>/dev/null)" ||
           [ "$(cd -- "$top" && pwd -P)" != "$candidate" ]; then
            echo "[governance] error: cannot verify linked-worktree framework Git identity: $candidate" >&2; return 1
        fi
        if [ "$sub_dir" != "$expected" ] || [[ "$sub_dir" != "$git_dir/modules/"* ]] ||
           [ "$head" != "$pin" ]; then
            echo "[governance] error: linked-worktree framework Git identity or pin mismatch: $candidate" >&2; return 1
        fi
        required="scripts/lib/python.sh scripts/hooks/$hook governance/SYSTEM_PROMPT.md governance_tools/hook_installer.py"
        if [ "$hook" = pre-commit ]; then
            required="$required governance_tools/plan_freshness.py governance_tools/memory_workflow.py governance_tools/manual_update_advisory.py"
        else
            required="$required scripts/run-runtime-governance.sh governance_tools/external_tree_inventory_guard.py"
        fi
        for entry in $required; do
            directory="$(cd -- "$candidate/${entry%/*}" 2>/dev/null && pwd -P)" || directory=""
            if [ ! -f "$candidate/$entry" ] || [ -L "$candidate/$entry" ] ||
               [[ "$directory" != "$candidate/"* ]]; then
                echo "[governance] error: missing or external linked-worktree framework entry: $candidate/$entry" >&2; return 1
            fi
        done
        echo "[governance] using framework $candidate (linked worktree's declared, initialized pinned submodule; shared root: $shared)" >&2
        printf '%s\n' "$candidate"
        return
    done < <(git -C "$target" config --file .gitmodules --null --get-regexp '^submodule\..*\.path$')
    if [ ! -d "$FRAMEWORK_ROOT" ]; then
        echo "[governance] error: missing shared framework root cannot be bound to a registered worktree: $FRAMEWORK_ROOT" >&2; return 1
    fi
    printf '%s\n' "$FRAMEWORK_ROOT"
)

FRAMEWORK_ROOT="$(resolve_worktree_framework pre-commit)" || exit 1

case "$FRAMEWORK_ROOT" in
    [A-Za-z]:*)
        DRIVE="${FRAMEWORK_ROOT:0:1}"
        DRIVE_PATH="${FRAMEWORK_ROOT:2}"
        DRIVE_PATH="${DRIVE_PATH//\\//}"
        DRIVE_LOWER="$(printf '%s' "$DRIVE" | tr '[:upper:]' '[:lower:]')"
        if [ -d "/mnt/$DRIVE_LOWER/$DRIVE_PATH" ]; then
            FRAMEWORK_ROOT="/mnt/$DRIVE_LOWER/$DRIVE_PATH"
        elif [ -d "/$DRIVE_LOWER/$DRIVE_PATH" ]; then
            FRAMEWORK_ROOT="/$DRIVE_LOWER/$DRIVE_PATH"
        fi
        ;;
esac
    FRAMEWORK_PYTHON_ROOT="$FRAMEWORK_ROOT"

PYTHON_LIB="$FRAMEWORK_ROOT/scripts/lib/python.sh"
if [ ! -f "$PYTHON_LIB" ]; then
    echo "⚠️  [governance] 找不到 framework Python helper: $PYTHON_LIB"
    exit 0
fi
. "$PYTHON_LIB"

# Advisory-only hook staleness check.
# `.git/hooks` is an untracked copy: when the framework source hook changes and
# the copy is not reinstalled, governance dispatch degrades silently and no
# canonical memory record is written. Observed 2026-08-04 (two merged PRs with
# no canonical record). Advisory only; never blocks a commit.
HOOK_SOURCE="$FRAMEWORK_ROOT/scripts/hooks/pre-commit"
HOOK_SELF="${BASH_SOURCE[0]:-}"
if [ -n "$HOOK_SELF" ] && [ -f "$HOOK_SOURCE" ] && [ -f "$HOOK_SELF" ]; then
    if ! cmp -s "$HOOK_SELF" "$HOOK_SOURCE"; then
        echo ""
        echo "⚠️  [governance] installed pre-commit hook differs from framework source"
        echo "   installed: $HOOK_SELF"
        echo "   source:    $HOOK_SOURCE"
        echo "   run: python -X utf8 -m governance_tools.hook_installer --repo . --framework-root \"$FRAMEWORK_ROOT\" --hooks-only"
        echo "   note: advisory only; commit is not blocked by this check"
        echo ""
    fi
fi

PLAN_FILE="$TARGET_REPO_ROOT/PLAN.md"
TOOL="$FRAMEWORK_ROOT/governance_tools/plan_freshness.py"
MEMORY_WORKFLOW_TOOL="$FRAMEWORK_ROOT/governance_tools/memory_workflow.py"
MANUAL_UPDATE_ADVISORY_TOOL="$FRAMEWORK_ROOT/governance_tools/manual_update_advisory.py"

# Execute each advisory with its own imports and the search path of a direct
# script invocation. Only an uncaught missing module gets a dependency hint.
run_python_advisory() {
    local advisory="$1"
    shift
    PYTHONPATH="$FRAMEWORK_PYTHON_ROOT${PYTHONPATH:+:$PYTHONPATH}" "${PYTHON_CMD[@]}" -c '
import sys

advisory = sys.argv[1]
del sys.argv[:2]
script = sys.argv[0]
prepend_script_dir = sys.path[:1] == [""]
if prepend_script_dir:
    del sys.path[0]

import os
import runpy

if prepend_script_dir:
    sys.path.insert(0, os.path.dirname(os.path.realpath(script)))

diagnostics = sys.stderr
if advisory == "memory workflow":
    # Memory workflow normally exposes only its parsed JSON output.
    sys.stderr = open(os.devnull, "w")

try:
    runpy.run_path(script, run_name="__main__")
except ModuleNotFoundError as error:
    if not error.name:
        raise
    message = (
        f"[governance] {advisory} advisory 檢查未執行：{sys.executable} 缺少 Python 模組 {error.name}。"
        "請設定 AI_GOVERNANCE_PYTHON 指向已安裝依賴的 Python。\n"
    )
    diagnostics.buffer.write(message.encode("utf-8"))
    raise SystemExit(1) from None
' "$advisory" "$@"
}

# Advisory-only memory workflow dispatch.
# Run the canonical guard so pre-commit mirrors the same policy evidence used
# by CI, but do not pass --fail-on-blocker: CI remains the authoritative gate
# and this hook never blocks a commit on memory policy.
if [ -f "$MEMORY_WORKFLOW_TOOL" ]; then
    if set_python_cmd; then
        MEMORY_WORKFLOW_RESULT=$(run_python_advisory "memory workflow" \
            "$MEMORY_WORKFLOW_TOOL" --repo "$TARGET_REPO_ROOT" --check --run-guard --format json) || true
        if [ -n "$MEMORY_WORKFLOW_RESULT" ]; then
            MEMORY_WORKFLOW_STATUS=$(echo "$MEMORY_WORKFLOW_RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('status',''))" 2>/dev/null || true)
            MEMORY_WORKFLOW_ALLOWED=$(echo "$MEMORY_WORKFLOW_RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('completion_claim_allowed', True))" 2>/dev/null || true)
            MEMORY_WORKFLOW_GUARD_RAN=$(echo "$MEMORY_WORKFLOW_RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('guard_ran', False))" 2>/dev/null || true)
            MEMORY_WORKFLOW_WARNINGS=$(echo "$MEMORY_WORKFLOW_RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(','.join(d.get('warnings') or []))" 2>/dev/null || true)
            if [ "$MEMORY_WORKFLOW_STATUS" = "memory_workflow_required" ] || [ -n "$MEMORY_WORKFLOW_WARNINGS" ]; then
                echo ""
                if [ "$MEMORY_WORKFLOW_STATUS" = "memory_workflow_required" ]; then
                    echo "[governance] memory workflow advisory: memory/** changes detected"
                else
                    echo "[governance] memory workflow advisory: report-only warnings detected"
                fi
                echo "  run: python -m governance_tools.memory_workflow --check --repo . --run-guard"
                if [ -n "$MEMORY_WORKFLOW_WARNINGS" ]; then
                    echo "  warning_codes=$MEMORY_WORKFLOW_WARNINGS"
                fi
                if [ "$MEMORY_WORKFLOW_GUARD_RAN" = "True" ] || [ "$MEMORY_WORKFLOW_GUARD_RAN" = "true" ]; then
                    echo "  completion_claim_allowed=$MEMORY_WORKFLOW_ALLOWED"
                else
                    echo "  guard_status=not_run_in_pre_commit_advisory"
                    echo "  completion_claim_allowed=not_evaluated_without_guard"
                    echo "  note: guard output was unavailable; run the command above before claiming memory completion"
                fi
                echo "  note: pre-commit advisory only; commit is not blocked by this check"
                echo ""
            fi
        fi
    fi
fi

# ── 跳過條件 ──────────────────────────────────────────────────────────────
# 沒有 PLAN.md → 跳過（可能是新專案或 examples/ 子目錄）
# Advisory-only protected baseline refresh reminder.
# If a protected file recorded in .governance/baseline.yaml is staged without
# the refreshed baseline, the protected-file hash check will later drift. This
# reminder is advisory only; it does not block the commit.

# Advisory-only manual governance update detection.
# Signal 1 only reports lock-vs-checkout mismatch when governance framework
# update-related paths are staged. Signal 2 reports staged framework lock
# changes without a staged updater/F-7 receipt. It never blocks, repairs,
# fetches, stages, or proves the updater was bypassed.
if [ -f "$MANUAL_UPDATE_ADVISORY_TOOL" ]; then
    if set_python_cmd; then
        run_python_advisory "manual update" "$MANUAL_UPDATE_ADVISORY_TOOL" \
            --repo "$TARGET_REPO_ROOT" \
            --framework-root "$FRAMEWORK_ROOT" \
            --format human || true
    fi
fi

BASELINE_FILE="$TARGET_REPO_ROOT/.governance/baseline.yaml"
if [ -f "$BASELINE_FILE" ]; then
    STAGED_FILES="$(git -C "$TARGET_REPO_ROOT" diff --cached --name-only 2>/dev/null || true)"
    if [ -n "$STAGED_FILES" ]; then
        BASELINE_STAGED=false
        if echo "$STAGED_FILES" | grep -qx ".governance/baseline.yaml"; then
            BASELINE_STAGED=true
        fi

        PROTECTED_STAGED=""
        while IFS= read -r protected_file; do
            if [ -n "$protected_file" ] && echo "$STAGED_FILES" | grep -qx "$protected_file"; then
                PROTECTED_STAGED="${PROTECTED_STAGED}${protected_file}
"
            fi
        done <<EOF
$(sed -n 's/^overridable\.\(.*\): protected[[:space:]]*$/\1/p' "$BASELINE_FILE")
EOF

        if [ -n "$PROTECTED_STAGED" ] && [ "$BASELINE_STAGED" != "true" ]; then
            echo ""
            echo "[governance] protected baseline refresh advisory: protected file changes detected"
            echo "$PROTECTED_STAGED" | sed 's/^/  protected: /'
            echo "  run: python governance_tools/adopt_governance.py --target . --refresh"
            echo "  note: pre-commit advisory only; commit is not blocked by this check"
            echo ""
        fi
    fi
fi
if [ ! -f "$PLAN_FILE" ]; then
    exit 0
fi

# 沒有 plan_freshness.py → 跳過（框架尚未部署）
if [ ! -f "$TOOL" ]; then
    exit 0
fi

# ── 檢查新鮮度 ────────────────────────────────────────────────────────────
# 嘗試取得 JSON 輸出；若 python 指令不存在則跳過
if ! set_python_cmd; then
    echo "⚠️  [governance] 找不到 Python，跳過 PLAN.md freshness 檢查"
    exit 0
fi

# 取得 JSON（exit code 不影響後續 shell 判斷）
RESULT=$("${PYTHON_CMD[@]}" "$TOOL" --file "$PLAN_FILE" --format json 2>/dev/null) || true

if [ -z "$RESULT" ]; then
    echo "⚠️  [governance] plan_freshness 回傳空值，跳過檢查"
    exit 0
fi

STATUS=$(echo "$RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('status','ERROR'))" 2>/dev/null || echo "ERROR")
DAYS=$(echo "$RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('days_since_update','?'))" 2>/dev/null || echo "?")
THRESHOLD=$(echo "$RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('threshold_days','?'))" 2>/dev/null || echo "?")

case "$STATUS" in
    FRESH)
        # 無輸出，靜默通過
        exit 0
        ;;
    STALE)
        echo ""
        echo "⚠️  [governance] PLAN.md 已 ${DAYS}d 未更新（閾值: ${THRESHOLD}d）"
        echo "   建議更新「最後更新」欄位與「本週聚焦」後再 commit"
        echo "   （STALE 允許通過；CRITICAL 會擋截）"
        echo ""
        exit 0
        ;;
    CRITICAL)
        echo ""
        echo "🔴 [governance] PLAN.md 嚴重過期：已 ${DAYS}d 未更新（臨界值: $((THRESHOLD * 2))d）"
        echo "   計畫可能已失效，請更新後再 commit："
        echo ""
        echo "   1. 更新 PLAN.md 的「最後更新」欄位（格式: YYYY-MM-DD）"
        echo "   2. 更新「本週聚焦」或「變更歷史」"
        echo "   3. git add PLAN.md && git commit"
        echo ""
        echo "   如需跳過此檢查（不建議）: git commit --no-verify"
        echo ""
        exit 1
        ;;
    ERROR)
        # 解析失敗（欄位缺失等）→ 警告但不擋
        ERRORS=$(echo "$RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); [print('  •',e) for e in d.get('errors',[])]" 2>/dev/null || true)
        echo ""
        echo "🚨 [governance] PLAN.md 解析錯誤，請確認 header 欄位格式："
        echo "$ERRORS"
        echo "   格式參考: governance/PLAN.md §2.1"
        echo "   （ERROR 允許通過，但請儘快修正）"
        echo ""
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
