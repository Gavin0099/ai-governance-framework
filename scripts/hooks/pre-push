#!/bin/bash
# pre-push hook - AI Governance Framework
# Enforces runtime governance checks. Memory policy is owned by the canonical
# CI gate and its advisory pre-commit mirror, not by pre-push.

set -euo pipefail

governance_error() {
    echo "[governance] error: $*" >&2
}

if ! command -v git >/dev/null 2>&1; then
    governance_error "git is required by the pre-push hook"
    exit 1
fi

HOOK_PATH="${BASH_SOURCE[0]}"
HOOK_PARENT="${HOOK_PATH%/*}"
if [ "$HOOK_PARENT" = "$HOOK_PATH" ]; then
    HOOK_PARENT="."
fi
if ! HOOK_DIR="$(cd -- "$HOOK_PARENT" && pwd -P)"; then
    governance_error "cannot resolve hook directory from: $HOOK_PATH"
    exit 1
fi

if ! TARGET_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if ! TARGET_REPO_ROOT="$(git -C "$HOOK_DIR" rev-parse --show-toplevel 2>/dev/null)"; then
        governance_error "cannot resolve target repository root"
        exit 1
    fi
fi

FRAMEWORK_ROOT="${AI_GOVERNANCE_FRAMEWORK_ROOT:-}"
HOOK_CONFIG="$HOOK_DIR/ai-governance-framework-root"
if [ -z "$FRAMEWORK_ROOT" ]; then
    if [ ! -f "$HOOK_CONFIG" ]; then
        governance_error "framework root config is missing: $HOOK_CONFIG"
        exit 1
    fi
    FRAMEWORK_ROOT=""
    IFS= read -r FRAMEWORK_ROOT < "$HOOK_CONFIG" || true
fi

FRAMEWORK_ROOT="${FRAMEWORK_ROOT%$'\r'}"
FRAMEWORK_ROOT="${FRAMEWORK_ROOT//\\//}"
if [ -z "$FRAMEWORK_ROOT" ]; then
    governance_error "framework root is not configured"
    exit 1
fi

# Keep this bootstrap self-contained: the shared checkout may have been removed.
# Only the configured submodule in a registered worktree can supply a local pin;
# an explicit override or an external installation keeps its existing authority.
resolve_worktree_framework() (
    local hook="$1" shared="$FRAMEWORK_ROOT" target="$TARGET_REPO_ROOT"
    local git_dir common record key relative anchor entry bound="" candidate name
    local bound_head="" matching="" declared
    local mode pin stage ignored sub_dir expected head top required directory
    if [ -n "${AI_GOVERNANCE_FRAMEWORK_ROOT:-}" ] || [ ! -f "$target/.git" ]; then
        printf '%s\n' "$shared"; return
    fi
    for name in $(git rev-parse --local-env-vars); do unset "$name"; done
    export GIT_OPTIONAL_LOCKS=0
    export GIT_NO_REPLACE_OBJECTS=1
    git_dir="$(git -C "$target" rev-parse --absolute-git-dir)" || return 1
    common="$(git -C "$target" rev-parse --git-common-dir)" || return 1
    git_dir="$(cd -- "$git_dir" && pwd -P)" || return 1
    common="$(cd -- "$target" && cd -- "$common" && pwd -P)" || return 1
    if [ "$git_dir" = "$common" ] || [ ! -f "$target/.gitmodules" ]; then
        printf '%s\n' "$shared"; return
    fi
    shared="${shared%$'\r'}"; shared="${shared//\\//}"
    # cygpath also normalizes drive paths that no longer exist.
    if command -v cygpath >/dev/null 2>&1; then shared="$(cygpath -am "$shared")"; fi
    while IFS= read -r -d '' record; do
        key="${record%%$'\n'*}"; relative="${record#*$'\n'}"
        case "$relative" in ""|/*|*:*|*\\*|../*|*/../*|*/..|.|..|./*|*/./*|*/.) continue ;; esac
        while IFS= read -r -d '' entry; do
            case "$entry" in
                "worktree "*)
                    matching=""
                    anchor="${entry#worktree }/$relative"
                    if command -v cygpath >/dev/null 2>&1; then anchor="$(cygpath -am "$anchor")"; fi
                    if [ "${shared%/}" = "${anchor%/}" ]; then
                        if [ -n "$bound" ]; then
                            echo "[governance] error: ambiguous linked-worktree framework declaration" >&2; return 1
                        fi
                        bound="$key"
                        matching=yes
                    fi ;;
                "HEAD "*) [ "$matching" != yes ] || bound_head="${entry#HEAD }" ;;
            esac
        done < <(git -C "$target" worktree list --porcelain -z)
        [ "$bound" = "$key" ] || continue
        # A nested external installation is not submodule authority. The
        # installing worktree's committed declaration must identify this slot.
        IFS=$' \t' read -r mode ignored < <(git --literal-pathspecs -C "$target" ls-tree "$bound_head" -- "$relative" 2>/dev/null)
        declared="$(git -C "$target" config --blob "$bound_head:.gitmodules" --get "$key" 2>/dev/null)" || declared=""
        if [ "${mode:-}" != 160000 ] || [ "$declared" != "$relative" ]; then
            if [ -d "$FRAMEWORK_ROOT" ]; then printf '%s\n' "$FRAMEWORK_ROOT"; return; fi
            echo "[governance] error: missing shared framework root has no committed submodule authority: $FRAMEWORK_ROOT" >&2; return 1
        fi
        candidate="$target/$relative"
        # HEAD, index and working declaration must agree before dispatching code.
        IFS=$' \t' read -r mode ignored < <(git -C "$target" ls-tree HEAD -- .gitmodules)
        case "${mode:-}" in
            100644|100755) ;;
            *) echo "[governance] error: linked-worktree framework declaration is not a committed regular file" >&2; return 1 ;;
        esac
        if [ -L "$target/.gitmodules" ] ||
           ! git -C "$target" diff --quiet HEAD -- .gitmodules ||
           ! git -C "$target" diff --cached --quiet HEAD -- .gitmodules; then
            echo "[governance] error: linked-worktree framework declaration is not committed and unchanged" >&2; return 1
        fi
        target="$(cd -- "$target" && pwd -P)" || return 1
        candidate="$target/$relative"
        name="${key#submodule.}"; name="${name%.path}"
        IFS=$' \t' read -r mode pin stage ignored < <(git --literal-pathspecs -C "$target" ls-files --stage -- "$relative")
        if [ "${mode:-}" != 160000 ] || [ "${stage:-}" != 0 ] ||
           [ ! -f "$candidate/.git" ] || [ -L "$candidate/.git" ] ||
           [ "$(cd -- "$candidate" 2>/dev/null && pwd -P)" != "$candidate" ]; then
            echo "[governance] error: linked-worktree framework is not an initialized declared submodule: $candidate" >&2; return 1
        fi
        if ! sub_dir="$(git -C "$candidate" rev-parse --absolute-git-dir 2>/dev/null)" ||
           ! sub_dir="$(cd -- "$sub_dir" && pwd -P)" ||
           ! expected="$(cd -- "$git_dir/modules/$name" 2>/dev/null && pwd -P)" ||
           ! head="$(git -C "$candidate" rev-parse --verify HEAD 2>/dev/null)" ||
           ! top="$(git -C "$candidate" rev-parse --show-toplevel 2>/dev/null)" ||
           [ "$(cd -- "$top" && pwd -P)" != "$candidate" ]; then
            echo "[governance] error: cannot verify linked-worktree framework Git identity: $candidate" >&2; return 1
        fi
        if [ "$sub_dir" != "$expected" ] || [[ "$sub_dir" != "$git_dir/modules/"* ]] ||
           [ "$head" != "$pin" ]; then
            echo "[governance] error: linked-worktree framework Git identity or pin mismatch: $candidate" >&2; return 1
        fi
        required="scripts/lib/python.sh scripts/hooks/$hook governance/SYSTEM_PROMPT.md governance_tools/hook_installer.py"
        if [ "$hook" = pre-commit ]; then
            required="$required governance_tools/plan_freshness.py governance_tools/memory_workflow.py governance_tools/manual_update_advisory.py"
        else
            required="$required scripts/run-runtime-governance.sh governance_tools/external_tree_inventory_guard.py"
        fi
        for entry in $required; do
            directory="$(cd -- "$candidate/${entry%/*}" 2>/dev/null && pwd -P)" || directory=""
            if [ ! -f "$candidate/$entry" ] || [ -L "$candidate/$entry" ] ||
               [[ "$directory" != "$candidate/"* ]]; then
                echo "[governance] error: missing or external linked-worktree framework entry: $candidate/$entry" >&2; return 1
            fi
        done
        echo "[governance] using framework $candidate (linked worktree's declared, initialized pinned submodule; shared root: $shared)" >&2
        printf '%s\n' "$candidate"
        return
    done < <(git -C "$target" config --file .gitmodules --null --get-regexp '^submodule\..*\.path$')
    if [ ! -d "$FRAMEWORK_ROOT" ]; then
        echo "[governance] error: missing shared framework root cannot be bound to a registered worktree: $FRAMEWORK_ROOT" >&2; return 1
    fi
    printf '%s\n' "$FRAMEWORK_ROOT"
)

FRAMEWORK_ROOT="$(resolve_worktree_framework pre-push)" || exit 1

if [ ! -d "$FRAMEWORK_ROOT" ]; then
    governance_error "framework root does not exist: $FRAMEWORK_ROOT"
    exit 1
fi

# WSL drive-path mapping is intentionally unsupported. The installer writes a
# path native to the shell environment that owns the hook. Git for Windows Bash
# accepts slash-normalized drive paths such as D:/repo directly.
FRAMEWORK_PYTHON_ROOT="$FRAMEWORK_ROOT"

PYTHON_LIB="$FRAMEWORK_ROOT/scripts/lib/python.sh"
if [ ! -f "$PYTHON_LIB" ]; then
    governance_error "missing framework Python helper: $PYTHON_LIB"
    exit 1
fi
. "$PYTHON_LIB"

if ! type set_python_cmd >/dev/null 2>&1; then
    governance_error "framework Python helper does not define set_python_cmd"
    exit 1
fi

PYTHON_CMD=()
if ! set_python_cmd; then
    governance_error "Python is required by the pre-push hook"
    exit 1
fi
if [ -z "${PYTHON_CMD[*]-}" ]; then
    governance_error "framework Python helper did not select a Python command"
    exit 1
fi

TOOL="$FRAMEWORK_ROOT/governance_tools/contract_validator.py"
VERSION_BUMP_GUARD="$FRAMEWORK_ROOT/governance_tools/version_bump_guard.py"
SNAPSHOT_DIR="$TARGET_REPO_ROOT/memory/governance_snapshots"
RUNTIME_SCRIPT="$FRAMEWORK_ROOT/scripts/run-runtime-governance.sh"
EXTERNAL_TREE_GUARD="$FRAMEWORK_ROOT/governance_tools/external_tree_inventory_guard.py"
EXTERNAL_TREE_IDENTITY_CONFIG="$TARGET_REPO_ROOT/governance/external-tree-inventory-guard.json"

if [ ! -f "$RUNTIME_SCRIPT" ]; then
    governance_error "missing runtime governance script: $RUNTIME_SCRIPT"
    exit 1
fi
if [ ! -f "$EXTERNAL_TREE_GUARD" ]; then
    governance_error "missing external tree inventory guard: $EXTERNAL_TREE_GUARD"
    exit 1
fi

echo "[governance] scanning pre-push newly-reachable JSON object closure"
EXTERNAL_TREE_GUARD_ARGS=(
    --pre-push-updates
    --repo-root "$TARGET_REPO_ROOT"
    --identity-config "$EXTERNAL_TREE_IDENTITY_CONFIG"
    --format human
)
HISTORICAL_JSON_DEBT_POLICY="$HOOK_DIR/external-tree-json-debt.json"
if [ -e "$HISTORICAL_JSON_DEBT_POLICY" ] || [ -L "$HISTORICAL_JSON_DEBT_POLICY" ]; then
    EXTERNAL_TREE_GUARD_ARGS+=(--historical-json-debt-policy "$HISTORICAL_JSON_DEBT_POLICY")
fi
set +e
"${PYTHON_CMD[@]}" "$EXTERNAL_TREE_GUARD" "${EXTERNAL_TREE_GUARD_ARGS[@]}"
EXTERNAL_TREE_GUARD_STATUS=$?
set -e
if [ "$EXTERNAL_TREE_GUARD_STATUS" -ne 0 ]; then
    governance_error "pre-push external tree inventory guard blocked the push"
    case "$EXTERNAL_TREE_GUARD_STATUS" in
        1|2|3)
            echo "  the reported blob is present in the updated-ref object history" >&2
            echo "  deleting the file in a later commit does not remove that blob" >&2
            echo "  amend, rebase, or filter the introducing history, then retry" >&2
            ;;
        4)
            echo "  scanner setup/object resolution failed; inspect the diagnostic above" >&2
            echo "  if the remote old object is missing locally, run git fetch and retry" >&2
            ;;
        *)
            echo "  inspect the diagnostic above and repair the scanner failure before retrying" >&2
            ;;
    esac
    echo "  emergency bypass only (disables all pre-push governance): git push --no-verify" >&2
    exit 1
fi

# Snapshot validation remains advisory-only.
FAIL_COUNT=0
if [ -f "$TOOL" ] && [ -d "$SNAPSHOT_DIR" ]; then
    for snapshot in "$SNAPSHOT_DIR"/*.txt; do
        [ -f "$snapshot" ] || continue
        RESULT=$("${PYTHON_CMD[@]}" "$TOOL" --file "$snapshot" --format json 2>/dev/null) || true
        STATUS=$(echo "$RESULT" | "${PYTHON_CMD[@]}" -c "import sys,json; d=json.load(sys.stdin); print(d.get('valid', True))" 2>/dev/null || echo "true")
        if [ "$STATUS" = "False" ]; then
            echo "[governance] warning: invalid AI contract snapshot: ${snapshot##*/}"
            FAIL_COUNT=$((FAIL_COUNT + 1))
        fi
    done
fi

if [ "$FAIL_COUNT" -gt 0 ]; then
    echo ""
    echo "[governance] warning: ${FAIL_COUNT} invalid AI contract snapshot(s) found"
    echo "  bypass once: git push --no-verify"
    echo ""
fi

# Framework development worktrees smoke their own implementation. Consumers
# continue to smoke the installed framework. Compare repository identity, not
# filenames, remote names, or whether a directory looks like a framework.
exact_root_common_dir() (
    local root="$1" name top common
    for name in $(git rev-parse --local-env-vars); do
        unset "$name"
    done
    cd -- "$root" || return 1
    root="$(pwd -P)"
    top="$(git rev-parse --show-toplevel 2>/dev/null)" || return 1
    [ "$(cd -- "$top" && pwd -P)" = "$root" ] || return 1
    common="$(git rev-parse --git-common-dir 2>/dev/null)" || return 1
    cd -- "$common" && pwd -P
)

SELF_SMOKE_ROOT="$FRAMEWORK_ROOT"
if TARGET_COMMON_DIR="$(exact_root_common_dir "$TARGET_REPO_ROOT")" &&
   FRAMEWORK_COMMON_DIR="$(exact_root_common_dir "$FRAMEWORK_ROOT")" &&
   [ "$TARGET_COMMON_DIR" = "$FRAMEWORK_COMMON_DIR" ]; then
    SELF_SMOKE_ROOT="$TARGET_REPO_ROOT"
fi
SELF_SMOKE_SCRIPT="$SELF_SMOKE_ROOT/scripts/run-runtime-governance.sh"
if [ ! -f "$SELF_SMOKE_SCRIPT" ]; then
    governance_error "missing selected self-smoke script: $SELF_SMOKE_SCRIPT"
    exit 1
fi

echo "[governance] running runtime-governance enforcement before push"
echo "[governance] runtime-governance smoke context: framework_self_smoke_advisory"
echo "[governance]   framework_root=$FRAMEWORK_ROOT"
echo "[governance]   target_repo_root=$TARGET_REPO_ROOT"
echo "[governance]   smoke_project_root=$SELF_SMOKE_ROOT"
echo "[governance]   checked_plan_path=$SELF_SMOKE_ROOT/PLAN.md"
if ! (cd "$SELF_SMOKE_ROOT" && /bin/bash "$SELF_SMOKE_SCRIPT" --mode smoke); then
    echo ""
    echo "[governance] runtime-governance enforcement failed"
    echo "  fix the runtime governance failures before push"
    echo "  bypass once: git push --no-verify"
    echo ""
    exit 1
fi

if [ -f "$VERSION_BUMP_GUARD" ]; then
    echo "[governance] version bump recommendation (advisory)"
    # Detect remote default branch via symbolic ref; fall back to origin/main.
    _VBG_BASE="$(git -C "$TARGET_REPO_ROOT" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || true)"
    _VBG_BASE="${_VBG_BASE#refs/remotes/}"
    [ -z "$_VBG_BASE" ] && _VBG_BASE="origin/main"
    (
        cd "$TARGET_REPO_ROOT"
        "${PYTHON_CMD[@]}" "$VERSION_BUMP_GUARD" --base-ref "$_VBG_BASE" --head-ref HEAD --format human
    ) || (
        cd "$TARGET_REPO_ROOT"
        "${PYTHON_CMD[@]}" "$VERSION_BUMP_GUARD" --base-ref HEAD~1 --head-ref HEAD --format human
    ) || true
fi

exit 0
