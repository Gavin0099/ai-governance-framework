{
  "admission": {
    "input_digest_fields": [
      "baseline_instruction_sha256",
      "task_packet_sha256",
      "treatment_packet_sha256",
      "governance_instruction_sha256",
      "validator_bundle_sha256",
      "validator_config_sha256",
      "permissions_sha256",
      "budget_sha256",
      "harness_contract_sha256",
      "scorer_rubric_sha256",
      "randomization_record_sha256"
    ],
    "required_equalities": [
      "admission.anon_id == metrics.anon_id == packet.anon_id",
      "admission.baseline_commit == metrics.baseline_commit == packet.baseline_commit",
      "admission.output_commit == packet.output_commit",
      "admission.output_packet_sha256 == sha256(packet_bytes)",
      "every_admission_input_digest == sha256(retained_input_artifact_bytes)",
      "admission.final_diff.sha256 == packet.final_diff_sha256 == sha256(git_diff_bytes)",
      "admission.receipt_set_sha256 == packet.receipt_set_sha256 == sha256(canonical_receipt_index)",
      "admission.event_log.sha256 == metrics.artifacts.event_log_sha256 == sha256(event_log_bytes)",
      "every_receipt.linked_commit == admission.output_commit",
      "every_receipt.output_sha256 == sha256(receipt_output_bytes)",
      "bundle_contains(admission.baseline_commit, admission.output_commit)",
      "git_merge_base_is_ancestor(admission.baseline_commit, admission.output_commit)",
      "live_capture_head == admission.output_commit",
      "live_capture_worktree_clean == true",
      "admission.treatment == released_mapping[admission.anon_id]",
      "admission.treatment_input_digests == preregistered_treatment_input_digests",
      "admission.baseline_test_receipt.sha256 == sha256(baseline_receipt_bytes)",
      "baseline_receipt.linked_commit == admission.baseline_commit",
      "baseline_receipt.exit_code != 0",
      "baseline_receipt.output_sha256 == sha256(baseline_output_bytes)",
      "metrics.method_observations.failing_regression_before_fix.evidence_sha256 contains admission.baseline_test_receipt.sha256"
    ],
    "retained_input_artifact_entry_fields": [
      "path",
      "sha256"
    ],
    "retained_input_artifact_fields": [
      "baseline_instruction_sha256",
      "task_packet_sha256",
      "treatment_packet_sha256",
      "governance_instruction_sha256",
      "validator_bundle_sha256",
      "validator_config_sha256",
      "permissions_sha256",
      "budget_sha256",
      "harness_contract_sha256",
      "scorer_rubric_sha256",
      "randomization_record_sha256"
    ],
    "schema": "gate3-outcome-admission.v1"
  },
  "authorization": "candidate_only_not_gate3_start_authority",
  "baseline_test_receipt": {
    "must_be_expected_failure": true,
    "must_be_named_by_method_observation": "failing_regression_before_fix",
    "must_link_baseline_commit": true,
    "must_report_non_zero_exit": true,
    "rationale": "regression_baseline_fail is only verifier evidence if a retained receipt shows the regression failing at the baseline commit. A metrics flag asserting the observation, with no artifact behind it, is self-report.",
    "required_fields": [
      "schema",
      "command",
      "exit_code",
      "expected_failure",
      "linked_commit",
      "output_path",
      "output_sha256"
    ],
    "schema_suffix": "baseline-test-receipt.v1",
    "schema_suffix_rationale": "The live and rehearsal harnesses name their baseline receipts differently; what must be pinned is the structure and the linkage, not one producer's string."
  },
  "git_proof": {
    "bundle_required": true,
    "final_diff_command": "git diff --binary --full-index baseline_commit output_commit --",
    "offline_commit_and_ancestor_verification_required": true,
    "tracked_path_command": "git diff --name-only -z baseline_commit output_commit --"
  },
  "owner_signature_gate": {
    "candidate_manifest_must_pin_this_contract": true,
    "non_counted_rehearsal_required": true,
    "owner_signature_forbidden_without_this_contract": true
  },
  "schema": "gate3-common-harness-contract.v1",
  "scorer_packet": {
    "field_policy": "exact_set_no_additional_top_level_fields",
    "forbidden_identity_substrings": [
      "arm",
      "assignment",
      "condition",
      "governance_instruction",
      "skill",
      "treatment",
      "validator_bundle",
      "validator_config"
    ],
    "identity_leak_policy": "no_key_or_string_value_anywhere_in_the_packet_may_name_or_reveal_the_arm_assignment",
    "rationale": "Blindness enforced only by withholding the mapping is not enforced at all if the packet itself names the arm.",
    "required_fields": [
      "schema",
      "anon_id",
      "baseline_commit",
      "output_commit",
      "final_diff_sha256",
      "receipt_set_sha256",
      "harness_contract_sha256",
      "scorer_payload"
    ],
    "schema": "gate3-outcome-packet.v1",
    "scorer_payload": {
      "allowed_fields": [
        "baseline_test_receipt_sha256",
        "final_diff_utf8",
        "test_exit_code"
      ],
      "field_policy": "exact_set_no_additional_fields",
      "identity_scan_exempt_fields": [
        "final_diff_utf8"
      ],
      "identity_scan_exempt_rationale": "Producer output cannot be constrained by vocabulary; a fix may legitimately contain any word. Its confidentiality is the sanitizer's job, not the packet schema's. Keys are never exempt.",
      "value_policy": "scalar_values_only_no_nested_objects_or_arrays"
    }
  },
  "test_receipt": {
    "index_policy": "sorted_unique_paths",
    "required_fields": [
      "schema",
      "command",
      "exit_code",
      "linked_commit",
      "output_path",
      "output_sha256"
    ],
    "schema": "gate3-test-evidence-receipt.v1"
  }
}
