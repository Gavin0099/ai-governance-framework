diff --git a/tests/test_pre_push_pushed_ref.py b/tests/test_pre_push_pushed_ref.py
new file mode 100644
index 0000000..602a9a8
--- /dev/null
+++ b/tests/test_pre_push_pushed_ref.py
@@ -0,0 +1,109 @@
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+HOOK = REPO_ROOT / "scripts" / "hooks" / "pre-push"
+
+
+def _run(cmd, cwd, env, input_text=None):
+    return subprocess.run(
+        cmd,
+        cwd=str(cwd),
+        env=env,
+        input=input_text,
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+
+
+def _git_env():
+    env = dict(os.environ)
+    env.update(
+        {
+            "GIT_AUTHOR_NAME": "Test",
+            "GIT_AUTHOR_EMAIL": "test@example.com",
+            "GIT_COMMITTER_NAME": "Test",
+            "GIT_COMMITTER_EMAIL": "test@example.com",
+        }
+    )
+    return env
+
+
+def _init_target_repo(tmp_path):
+    repo = tmp_path / "target"
+    repo.mkdir()
+    env = _git_env()
+    _run(["git", "init", "-q", "-b", "main"], repo, env)
+    (repo / "base.txt").write_text("base\n")
+    _run(["git", "add", "base.txt"], repo, env)
+    _run(["git", "commit", "-q", "-m", "base"], repo, env)
+    base_sha = _run(["git", "rev-parse", "HEAD"], repo, env).stdout.strip()
+    _run(["git", "update-ref", "refs/remotes/origin/main", base_sha], repo, env)
+    _run(
+        ["git", "symbolic-ref", "refs/remotes/origin/HEAD", "refs/remotes/origin/main"],
+        repo,
+        env,
+    )
+    return repo, env, base_sha
+
+
+def _make_framework_root(tmp_path):
+    fw = tmp_path / "framework"
+    (fw / "scripts" / "lib").mkdir(parents=True)
+    (fw / "governance_tools").mkdir(parents=True)
+    shutil.copy(REPO_ROOT / "scripts" / "lib" / "python.sh", fw / "scripts" / "lib" / "python.sh")
+    shutil.copy(
+        REPO_ROOT / "governance_tools" / "version_bump_guard.py",
+        fw / "governance_tools" / "version_bump_guard.py",
+    )
+    return fw
+
+
+def _build_pushed_commit(repo, env, base_sha):
+    blob_sha = _run(
+        ["git", "hash-object", "-w", "--stdin"], repo, env, input_text="new\n"
+    ).stdout.strip()
+    base_tree = _run(
+        ["git", "rev-parse", base_sha + "^{tree}"], repo, env
+    ).stdout.strip()
+    listing = _run(["git", "ls-tree", base_tree], repo, env).stdout
+    mktree_input = listing + f"100644 blob {blob_sha}\tadded.txt\n"
+    new_tree = _run(["git", "mktree"], repo, env, input_text=mktree_input).stdout.strip()
+    commit = _run(
+        ["git", "commit-tree", new_tree, "-p", base_sha, "-m", "feature"], repo, env
+    ).stdout.strip()
+    _run(["git", "update-ref", "refs/heads/feature", commit], repo, env)
+    return commit
+
+
+def test_version_bump_advisory_uses_pushed_commit_not_local_head(tmp_path):
+    repo, env, base_sha = _init_target_repo(tmp_path)
+    framework_root = _make_framework_root(tmp_path)
+
+    # Commit is built via plumbing; HEAD stays on main at base_sha.
+    pushed_commit = _build_pushed_commit(repo, env, base_sha)
+    assert _run(["git", "rev-parse", "HEAD"], repo, env).stdout.strip() == base_sha
+
+    hook_env = dict(env)
+    hook_env["AI_GOVERNANCE_FRAMEWORK_ROOT"] = str(framework_root)
+    stdin = (
+        f"refs/heads/feature {pushed_commit} refs/heads/feature "
+        "0000000000000000000000000000000000000000\n"
+    )
+
+    result = subprocess.run(
+        ["bash", str(HOOK)],
+        cwd=str(repo),
+        env=hook_env,
+        input=stdin,
+        capture_output=True,
+        text=True,
+    )
+
+    assert result.returncode == 0, result.stderr
+    assert "changed_files=1" in result.stdout, result.stdout
+    assert "added.txt" in result.stdout
+    assert "changed_files=0" not in result.stdout
